import 'package:flutter/material.dart';
import 'package:flutter_bloc/flutter_bloc.dart';
import 'auth/auth_cubit.dart';
import 'cart/cart_bloc.dart';
import 'screens/login_screen.dart';

void main() => runApp(const TechShopApp());
class TechShopApp extends StatelessWidget {
  const TechShopApp({super.key});
  @override
  Widget build(BuildContext context) => MultiBlocProvider(
    providers: [
      BlocProvider(create: (_) => AuthCubit()),
      BlocProvider(create: (_) => CartBloc()),
    ],
    child: MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'TechShop',
      theme: ThemeData(useMaterial3: true, colorSchemeSeed: const Color(0xFF2458A6), scaffoldBackgroundColor: const Color(0xFFF5F7FA)),
      home: const LoginScreen(),
    ),
  );
}
