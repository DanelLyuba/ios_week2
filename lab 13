import 'dart:async';
import 'dart:io';
import 'package:flutter/material.dart';
import 'package:geolocator/geolocator.dart';
import 'package:image_picker/image_picker.dart';
import 'package:path_provider/path_provider.dart';
import 'package:permission_handler/permission_handler.dart';
import 'diary.dart';

void main() => runApp(const PhotoJournal());

class PhotoJournal extends StatelessWidget {
  const PhotoJournal({super.key});
  @override
  Widget build(BuildContext context) => MaterialApp(
    debugShowCheckedModeBanner: false, title: 'Narxoz Photo Journal',
    theme: ThemeData(useMaterial3: true, colorSchemeSeed: const Color(0xff315C52),
      scaffoldBackgroundColor: const Color(0xffF5F7F5)),
    home: const JournalScreen());
}

class JournalScreen extends StatefulWidget {
  const JournalScreen({super.key});
  @override
  State<JournalScreen> createState() => _JournalScreenState();
}

class _JournalScreenState extends State<JournalScreen> {
  final _picker = ImagePicker();
  final _caption = TextEditingController();
  DiaryStore? _store;
  List<DiaryEntry> _entries = [];
  XFile? _photo;
  Position? _position;
  DateTime? _selectedAt;
  bool _initializing = true, _picking = false, _locating = false, _saving = false;
  bool get _busy => _initializing || _picking || _locating || _saving;

  @override
  void initState() { super.initState(); _initialize(); }
  @override
  void dispose() { _caption.dispose(); super.dispose(); }

  void _message(String message, {bool error = false, SnackBarAction? action}) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(message),
      behavior: SnackBarBehavior.floating, backgroundColor: error ? Colors.red.shade800 : null,
      action: action));
  }

  Future<void> _initialize() async {
    try {
      final dir = await getApplicationDocumentsDirectory();
      final store = DiaryStore(Directory('${dir.path}/photo_diary'));
      final entries = await store.load();
      if (!mounted) return;
      setState(() { _store = store; _entries = entries; });
    } catch (e) { _message('Could not load diary: $e', error: true); }
    try {
      if (Platform.isAndroid) {
        final result = await _picker.retrieveLostData();
        if (!mounted) return;
        if (result.files?.isNotEmpty ?? false) {
          setState(() { _photo = result.files!.first; _selectedAt = DateTime.now(); });
        } else if (result.exception != null) {
          _message('Could not recover photo: ${result.exception}', error: true);
        }
      }
    } catch (e) { _message('Photo recovery failed: $e', error: true); }
    finally { if (mounted) setState(() => _initializing = false); }
  }

  Future<bool> _mediaPermission(Permission permission) async {
    var status = await permission.status;
    if (!status.isGranted && !status.isLimited && !status.isPermanentlyDenied && !status.isRestricted) {
      status = await permission.request();
    }
    if (status.isGranted || status.isLimited) return true;
    _message('Media access was denied.', error: true,
      action: SnackBarAction(label: 'Settings', onPressed: () { openAppSettings(); }));
    return false;
  }

  Future<void> _pick(ImageSource source) async {
    if (_busy) return;
    setState(() => _picking = true);
    try {
      if (source == ImageSource.camera && !await _mediaPermission(Permission.camera)) return;
      // Android system photo picker / document picker grants access to the chosen file.
      // On iOS request library access, accepting limited access too.
      if (source == ImageSource.gallery && Platform.isIOS && !await _mediaPermission(Permission.photos)) return;
      final photo = await _picker.pickImage(source: source, imageQuality: 80, maxWidth: 1080);
      if (!mounted || photo == null) return;
      setState(() { _photo = photo; _selectedAt = DateTime.now(); _position = null; });
    } catch (e) { _message('Unable to select photo: $e', error: true); }
    finally { if (mounted) setState(() => _picking = false); }
  }

  Future<void> _fetchLocation() async {
    if (_busy) return;
    setState(() { _locating = true; _position = null; });
    try {
      if (!await Geolocator.isLocationServiceEnabled()) {
        _message('GPS is disabled. Please enable location services.', error: true,
          action: SnackBarAction(label: 'Enable GPS', onPressed: () { Geolocator.openLocationSettings(); }));
        return;
      }
      var permission = await Geolocator.checkPermission();
      if (permission == LocationPermission.denied) permission = await Geolocator.requestPermission();
      if (permission == LocationPermission.deniedForever) {
        _message('Location permission is permanently denied.', error: true,
          action: SnackBarAction(label: 'Settings', onPressed: () { Geolocator.openAppSettings(); }));
        return;
      }
      if (permission != LocationPermission.whileInUse && permission != LocationPermission.always) {
        _message('Location permission denied. Please allow GPS access.', error: true); return;
      }
      final position = await Geolocator.getCurrentPosition(desiredAccuracy: LocationAccuracy.high,
        timeLimit: const Duration(seconds: 25));
      if (mounted) setState(() => _position = position);
    } on TimeoutException { _message('GPS timed out. Try again outdoors.', error: true); }
    catch (e) { _message('Could not get location: $e', error: true); }
    finally { if (mounted) setState(() => _locating = false); }
  }

  Future<void> _save() async {
    if (_busy) return;
    final photo = _photo; final position = _position; final store = _store;
    final caption = _caption.text.trim();
    if (photo == null || position == null || caption.isEmpty) {
      _message('Select a photo, fetch GPS and enter a caption first.', error: true); return;
    }
    if (store == null) { _message('Diary storage unavailable. Restart the app.', error: true); return; }
    setState(() => _saving = true);
    File? copied;
    try {
      await store.root.create(recursive: true);
      final now = DateTime.now();
      final suffix = photo.path.split('.').last.toLowerCase();
      final ext = RegExp(r'^[a-z0-9]{1,8}$').hasMatch(suffix) ? suffix : 'jpg';
      final name = 'photo_${now.microsecondsSinceEpoch}.$ext';
      copied = await File(photo.path).copy(store.photoFile(name).path);
      final entry = DiaryEntry(photo: name, caption: caption, timestamp: now,
        latitude: position.latitude, longitude: position.longitude,
        altitude: position.altitude, accuracy: position.accuracy);
      final updated = [entry, ..._entries];
      await store.write(updated);
      if (!mounted) return;
      setState(() { _entries = updated; _photo = null; _position = null; _selectedAt = null; _caption.clear(); });
      FocusScope.of(context).unfocus();
      _message('Entry saved offline.');
    } catch (e) {
      try { if (copied != null && await copied.exists()) await copied.delete(); } catch (_) {}
      _message('Could not save entry: $e', error: true);
    } finally { if (mounted) setState(() => _saving = false); }
  }

  Widget _spinner() => const SizedBox(width: 20, height: 20, child: CircularProgressIndicator(strokeWidth: 2));
  Widget _photoPreview() => ClipRRect(borderRadius: BorderRadius.circular(16), child: AspectRatio(
    aspectRatio: 16 / 10, child: _photo == null ? ColoredBox(color: const Color(0xffE3EBE6),
      child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
        Icon(Icons.photo_camera_outlined, size: 48, color: Theme.of(context).colorScheme.primary),
        const SizedBox(height: 8), const Text('Capture a moment or choose a photo')])) :
      Image.file(File(_photo!.path), fit: BoxFit.cover, errorBuilder: (_, __, ___) => const Center(child: Text('Image unavailable')))));

  Widget _metric(IconData icon, String label, String value) => Padding(padding: const EdgeInsets.symmetric(vertical: 5),
    child: Row(children: [Icon(icon, size: 19), const SizedBox(width: 10), Text(label), const Spacer(), Flexible(child: Text(value, textAlign: TextAlign.end, style: const TextStyle(fontWeight: FontWeight.w600)))]));

  Widget _entryTile(DiaryEntry entry) => Card(child: ListTile(contentPadding: const EdgeInsets.all(12),
    leading: ClipRRect(borderRadius: BorderRadius.circular(10), child: Image.file(_store!.photoFile(entry.photo),
      width: 70, height: 70, fit: BoxFit.cover, errorBuilder: (_, __, ___) => const SizedBox(width: 70, child: Icon(Icons.broken_image)))),
    title: Text(entry.caption, maxLines: 2, overflow: TextOverflow.ellipsis),
    subtitle: Text('${entry.latitude.toStringAsFixed(6)}°, ${entry.longitude.toStringAsFixed(6)}°\n${formatTime(entry.timestamp)}\nAccuracy ± ${entry.accuracy.toStringAsFixed(1)} m'),
    isThreeLine: true, onTap: () => showDialog<void>(context: context, builder: (context) => AlertDialog(
      title: Text(entry.caption), content: SingleChildScrollView(child: Column(mainAxisSize: MainAxisSize.min, crossAxisAlignment: CrossAxisAlignment.start, children: [
        Image.file(_store!.photoFile(entry.photo), errorBuilder: (_, __, ___) => const Text('Image unavailable')),
        const SizedBox(height: 12), Text('Latitude: ${entry.latitude.toStringAsFixed(6)}\nLongitude: ${entry.longitude.toStringAsFixed(6)}\nAltitude: ${entry.altitude.toStringAsFixed(1)} m\nAccuracy: ± ${entry.accuracy.toStringAsFixed(1)} m\n${formatTime(entry.timestamp)}')])),
      actions: [TextButton(onPressed: () => Navigator.pop(context), child: const Text('Close'))]))));

  @override
  Widget build(BuildContext context) {
    final p = _position;
    return Scaffold(appBar: AppBar(title: const Text('Narxoz Photo Journal'), actions: [Padding(padding: const EdgeInsets.only(right: 16), child: Chip(label: Text('${_entries.length} entries')))]),
      body: SafeArea(child: _initializing ? const Center(child: CircularProgressIndicator()) : ListView(
        padding: const EdgeInsets.all(16), children: [
          Text('Capture your day', style: Theme.of(context).textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.bold)),
          const Text('A personal diary of places and moments. Saved on this device.'), const SizedBox(height: 16),
          _photoPreview(), const SizedBox(height: 12),
          Row(children: [Expanded(child: FilledButton.tonalIcon(onPressed: _busy ? null : () => _pick(ImageSource.camera), icon: const Icon(Icons.camera_alt_outlined), label: const Text('Take Photo'))),
            const SizedBox(width: 8), Expanded(child: FilledButton.tonalIcon(onPressed: _busy ? null : () => _pick(ImageSource.gallery), icon: const Icon(Icons.photo_library_outlined), label: const Text('Pick Gallery')))]),
          if (_picking) const LinearProgressIndicator(),
          const SizedBox(height: 12), Card(child: Padding(padding: const EdgeInsets.all(16), child: Column(children: [
            _metric(Icons.my_location, 'Latitude', p?.latitude.toStringAsFixed(6) ?? 'Not fetched'),
            _metric(Icons.location_on_outlined, 'Longitude', p?.longitude.toStringAsFixed(6) ?? 'Not fetched'),
            _metric(Icons.terrain, 'Altitude', p == null ? '—' : '${p.altitude.toStringAsFixed(1)} m'),
            _metric(Icons.gps_fixed, 'Accuracy', p == null ? '—' : '± ${p.accuracy.toStringAsFixed(1)} m'),
            _metric(Icons.schedule, 'Timestamp', _selectedAt == null ? '—' : formatTime(_selectedAt!)),
            const SizedBox(height: 10), SizedBox(width: double.infinity, child: OutlinedButton.icon(onPressed: _busy ? null : _fetchLocation, icon: _locating ? _spinner() : const Icon(Icons.gps_fixed), label: Text(_locating ? 'Fetching GPS…' : 'Fetch Current GPS Location'))),
          ]))), const SizedBox(height: 12),
          TextField(controller: _caption, enabled: !_saving, maxLength: 120, decoration: const InputDecoration(labelText: 'Caption', hintText: 'Campus Quad at Narxoz', prefixIcon: Icon(Icons.edit_note), border: OutlineInputBorder())),
          FilledButton.icon(onPressed: _busy ? null : _save, icon: _saving ? _spinner() : const Icon(Icons.save_outlined), label: const Text('SAVE ENTRY TO DIARY')),
          const SizedBox(height: 24), Text('Diary entries', style: Theme.of(context).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.bold)),
          if (_entries.isEmpty) const Padding(padding: EdgeInsets.symmetric(vertical: 24), child: Center(child: Text('No entries yet. Save your first memory!'))),
          ..._entries.map(_entryTile), const SizedBox(height: 24),
        ])));
  }
}
